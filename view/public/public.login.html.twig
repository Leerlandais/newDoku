{% extends "template.html.twig" %}
{% block title %}{{ parent() }} | Login{% endblock %}
{% block content %}
    <div class="flex-1 max-w-md mx-auto px-6 py-8">
        <form method="POST" class="bg-surface-card border border-border rounded-lg shadow-sm overflow-hidden font-sans">
            <div class="p-6 md:p-8 space-y-6">
                <div>
                    <div class="flex items-baseline justify-between mb-2">
                        <label for="login_user"
                               class="block text-xs font-mono uppercase font-bold text-text tracking-wider">
                            Username <span class="text-primary">*</span>
                        </label>
                        <input type="text" id="login_user" name="str:user_name"
                               class="border border-gray-300 rounded-md px-2 py-1">
                    </div>
                    <div class="flex items-baseline justify-between mb-2">
                        <label for="login_pass"
                               class="block text-xs font-mono uppercase font-bold text-text tracking-wider">
                            Password <span class="text-primary">*</span>
                        </label>
                        <input type="password" id="login_pass" name="str:user_pass"
                               class="border border-gray-300 rounded-md px-2 py-1">
                    </div>
                </div>
            </div>
            <!-- Form Actions -->

                <div class="flex flex-row items-center justify-center gap-3 w-full sm:w-auto order-1 sm:order-2">
                    <input type="hidden" name="csrf:csrf_token" value="{{ csrfToken }}">
                    <button type="submit"
                            class="w-fit sm:w-auto px-6 py-2.5 bg-primary text-white font-bold rounded hover:bg-primary-dark transition-colors shadow-sm focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2"
                            name="unset:entryUser">
                        Login
                    </button>
                </div>

        </form>
    </div>
{% endblock %}
