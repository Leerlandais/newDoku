{% extends 'template.html.twig' %}   
{% block content %}
    <body class="bg-surface font-body-md text-body-md text-on-surface antialiased">

    <main class="w-full pt-20 bg-surface min-h-[calc(100vh-5rem)]">
        <div class="flex flex-col w-full">
            <div class="w-full px-margin py-space-xl flex flex-col gap-space-xl max-w-[1440px] mx-auto">
                <!-- Top Action & Date Anchor -->
                <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-space-lg">
                    <h1 class="font-headline-xl text-headline-xl text-on-surface tracking-tight">Today's Solved
                        Puzzles</h1>
                </div>
                <!-- Action Group -->
                <div class="flex flex-wrap items-center gap-space-md">
                    <a class="font-label-md text-label-md bg-primary text-on-primary px-space-lg py-space-sm transition-all duration-150 flex items-center gap-space-xs hover:bg-inverse-surface focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2"
                       data-path="all-solved-puzzles" href="#">
                        <span>View All Solved Puzzles</span>
                        <span class="material-symbols-outlined text-base">arrow_forward</span>
                    </a>
                    <button class="font-label-md text-label-md bg-surface-container-low text-on-surface px-space-lg py-space-sm border border-outline-variant hover:bg-surface-container transition-all flex items-center gap-space-xs focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2"
                            id="quick-log-btn">
                        <span class="material-symbols-outlined text-base text-primary">add_box</span>
                        <span>Log New Solve</span>
                    </button>
                </div>
            </div>

            <!-- Main Solves Log Data View -->
            <div class="bg-surface-container-lowest border-2 border-on-surface flex flex-col">

                <!-- High-Contrast Analytical Table -->
                <div class="overflow-x-auto w-full">
                    <table class="w-full text-left border-collapse">
                        <thead>
                        <tr class="border-b-2 border-on-surface bg-surface-cream text-secondary font-label-sm text-label-sm">
                            <th class="py-space-md px-space-lg border-r border-outline-variant font-medium w-36"
                                scope="col">PUZZLE ID
                            </th>
                            <th class="py-space-md px-space-lg border-r border-outline-variant font-medium" scope="col">
                                PUZZLE / AUTHOR
                            </th>
                            <th class="py-space-md px-space-lg border-r border-outline-variant font-medium" scope="col">
                                VARIANT CONSTRAINTS
                            </th>
                            <th class="py-space-md px-space-lg border-r border-outline-variant font-medium" scope="col">
                                SOLVER SOURCE
                            </th>
                            <th class="py-space-md px-space-lg border-r border-outline-variant font-medium text-right w-36"
                                scope="col">TIME
                            </th>
                            <th class="py-space-md px-space-lg font-medium text-center w-28" scope="col">ACTION</th>
                        </tr>
                        </thead>
                        <tbody class="divide-y divide-outline-variant font-body-md text-body-md">
                        <!-- Row 1 -->
                        <tr class="hover:bg-surface-cream/80 transition-colors group">
                            <td class="py-space-md px-space-lg border-r border-outline-variant font-label-md text-label-md text-on-surface-variant group-hover:text-primary font-semibold">
                                #SUD-2841
                            </td>
                            <td class="py-space-md px-space-lg border-r border-outline-variant">
                                <div class="flex flex-col">
                                    <span class="font-headline-md text-base font-semibold text-on-surface leading-snug">Whispering Whispers</span>
                                    <span class="font-body-sm text-body-sm text-secondary">by Philip Newman</span>
                                </div>
                            </td>
                            <td class="py-space-md px-space-lg border-r border-outline-variant">
                                <div class="flex flex-wrap gap-1.5">
                                    <span class="font-label-sm text-label-sm px-space-xs py-0.5 border border-outline-variant bg-surface text-on-surface">German Whisper</span>
                                    <span class="font-label-sm text-label-sm px-space-xs py-0.5 border border-outline-variant bg-surface text-secondary">Parity</span>
                                </div>
                            </td>
                            <td class="py-space-md px-space-lg border-r border-outline-variant">
                                <a class="font-label-sm text-label-sm text-primary hover:text-inverse-surface inline-flex items-center gap-1 focus:outline-none focus:ring-1 focus:ring-primary underline decoration-outline-variant underline-offset-2"
                                   href="https://crackingthecryptic.com/play/2841" rel="noopener noreferrer"
                                   target="_blank">
                                    <span>ctc.app/2841</span>
                                    <span class="material-symbols-outlined text-xs">open_in_new</span>
                                </a>
                            </td>
                            <td class="py-space-md px-space-lg border-r border-outline-variant font-grid-digit-sm text-label-md font-semibold text-right text-on-surface">
                                24:18
                            </td>
                            <td class="py-space-md px-space-lg text-center">
                                <a class="font-label-sm text-label-sm px-space-md py-1 border border-outline hover:border-primary hover:bg-primary hover:text-on-primary transition-all inline-block focus:outline-none focus:ring-2 focus:ring-primary"
                                   data-path="puzzle-details" href="#">
                                    Details
                                </a>
                            </td>
                        </tr>
                        <!-- Row 2 (Highlighted Solve) -->
                        <tr class="hover:bg-surface-cream/80 transition-colors group bg-surface-container-low/40">
                            <td class="py-space-md px-space-lg border-r border-outline-variant font-label-md text-label-md text-on-surface-variant group-hover:text-primary font-semibold">
                                #SUD-2840
                            </td>
                            <td class="py-space-md px-space-lg border-r border-outline-variant">
                                <div class="flex flex-col">
                                    <div class="flex items-center gap-space-xs">
                                        <span class="font-headline-md text-base font-semibold text-on-surface leading-snug">The Miracle II</span>
                                        <span class="font-label-sm text-label-sm px-1.5 py-0.2 bg-tertiary-fixed text-on-tertiary-fixed font-medium">HARD</span>
                                    </div>
                                    <span class="font-body-sm text-body-sm text-secondary">by Mitchell Lee</span>
                                </div>
                            </td>
                            <td class="py-space-md px-space-lg border-r border-outline-variant">
                                <div class="flex flex-wrap gap-1.5">
                                    <span class="font-label-sm text-label-sm px-space-xs py-0.5 border border-outline-variant bg-surface text-on-surface">Knight's Move</span>
                                    <span class="font-label-sm text-label-sm px-space-xs py-0.5 border border-outline-variant bg-surface text-on-surface">King's Move</span>
                                    <span class="font-label-sm text-label-sm px-space-xs py-0.5 border border-outline-variant bg-surface text-secondary">Orthogonal</span>
                                </div>
                            </td>
                            <td class="py-space-md px-space-lg border-r border-outline-variant">
                                <a class="font-label-sm text-label-sm text-primary hover:text-inverse-surface inline-flex items-center gap-1 focus:outline-none focus:ring-1 focus:ring-primary underline decoration-outline-variant underline-offset-2"
                                   href="https://crackingthecryptic.com/play/2840" rel="noopener noreferrer"
                                   target="_blank">
                                    <span>ctc.app/2840</span>
                                    <span class="material-symbols-outlined text-xs">open_in_new</span>
                                </a>
                            </td>
                            <td class="py-space-md px-space-lg border-r border-outline-variant font-grid-digit-sm text-label-md font-semibold text-right text-on-surface">
                                41:05
                            </td>
                            <td class="py-space-md px-space-lg text-center">
                                <a class="font-label-sm text-label-sm px-space-md py-1 border border-outline hover:border-primary hover:bg-primary hover:text-on-primary transition-all inline-block focus:outline-none focus:ring-2 focus:ring-primary"
                                   data-path="puzzle-details" href="#">
                                    Details
                                </a>
                            </td>
                        </tr>
                        <!-- Row 3 -->
                        <tr class="hover:bg-surface-cream/80 transition-colors group">
                            <td class="py-space-md px-space-lg border-r border-outline-variant font-label-md text-label-md text-on-surface-variant group-hover:text-primary font-semibold">
                                #SUD-2839
                            </td>
                            <td class="py-space-md px-space-lg border-r border-outline-variant">
                                <div class="flex flex-col">
                                    <div class="flex items-center gap-space-xs">
                                        <span class="font-headline-md text-base font-semibold text-on-surface leading-snug">Little Killer Symphony</span>
                                        <span class="font-label-sm text-label-sm px-1.5 py-0.2 bg-tertiary-fixed text-on-tertiary-fixed font-medium">HARD</span>
                                    </div>
                                    <span class="font-body-sm text-body-sm text-secondary">by Clover</span>
                                </div>
                            </td>
                            <td class="py-space-md px-space-lg border-r border-outline-variant">
                                <div class="flex flex-wrap gap-1.5">
                                    <span class="font-label-sm text-label-sm px-space-xs py-0.5 border border-outline-variant bg-surface text-on-surface">Little Killer</span>
                                    <span class="font-label-sm text-label-sm px-space-xs py-0.5 border border-outline-variant bg-surface text-on-surface">Killer Cages</span>
                                </div>
                            </td>
                            <td class="py-space-md px-space-lg border-r border-outline-variant">
                                <a class="font-label-sm text-label-sm text-primary hover:text-inverse-surface inline-flex items-center gap-1 focus:outline-none focus:ring-1 focus:ring-primary underline decoration-outline-variant underline-offset-2"
                                   href="https://crackingthecryptic.com/play/2839" rel="noopener noreferrer"
                                   target="_blank">
                                    <span>ctc.app/2839</span>
                                    <span class="material-symbols-outlined text-xs">open_in_new</span>
                                </a>
                            </td>
                            <td class="py-space-md px-space-lg border-r border-outline-variant font-grid-digit-sm text-label-md font-semibold text-right text-tertiary-container">
                                52:30
                            </td>
                            <td class="py-space-md px-space-lg text-center">
                                <a class="font-label-sm text-label-sm px-space-md py-1 border border-outline hover:border-primary hover:bg-primary hover:text-on-primary transition-all inline-block focus:outline-none focus:ring-2 focus:ring-primary"
                                   data-path="puzzle-details" href="#">
                                    Details
                                </a>
                            </td>
                        </tr>
                        <!-- Row 4 -->
                        <tr class="hover:bg-surface-cream/80 transition-colors group">
                            <td class="py-space-md px-space-lg border-r border-outline-variant font-label-md text-label-md text-on-surface-variant group-hover:text-primary font-semibold">
                                #SUD-2838
                            </td>
                            <td class="py-space-md px-space-lg border-r border-outline-variant">
                                <div class="flex flex-col">
                                    <span class="font-headline-md text-base font-semibold text-on-surface leading-snug">Arrowhead Matrix</span>
                                    <span class="font-body-sm text-body-sm text-secondary">by BremSter</span>
                                </div>
                            </td>
                            <td class="py-space-md px-space-lg border-r border-outline-variant">
                                <div class="flex flex-wrap gap-1.5">
                                    <span class="font-label-sm text-label-sm px-space-xs py-0.5 border border-outline-variant bg-surface text-on-surface">Arrow Sudoku</span>
                                    <span class="font-label-sm text-label-sm px-space-xs py-0.5 border border-outline-variant bg-surface text-secondary">Renban</span>
                                </div>
                            </td>
                            <td class="py-space-md px-space-lg border-r border-outline-variant">
                                <a class="font-label-sm text-label-sm text-primary hover:text-inverse-surface inline-flex items-center gap-1 focus:outline-none focus:ring-1 focus:ring-primary underline decoration-outline-variant underline-offset-2"
                                   href="https://crackingthecryptic.com/play/2838" rel="noopener noreferrer"
                                   target="_blank">
                                    <span>ctc.app/2838</span>
                                    <span class="material-symbols-outlined text-xs">open_in_new</span>
                                </a>
                            </td>
                            <td class="py-space-md px-space-lg border-r border-outline-variant font-grid-digit-sm text-label-md font-semibold text-right text-primary">
                                18:45
                            </td>
                            <td class="py-space-md px-space-lg text-center">
                                <a class="font-label-sm text-label-sm px-space-md py-1 border border-outline hover:border-primary hover:bg-primary hover:text-on-primary transition-all inline-block focus:outline-none focus:ring-2 focus:ring-primary"
                                   data-path="puzzle-details" href="#">
                                    Details
                                </a>
                            </td>
                        </tr>
                        </tbody>
                    </table>
                </div>

            </div>

        </div>
        <!-- Micro-interaction for Log New Solve Modal / Drawer -->
        <div class="hidden fixed inset-0 z-50 bg-inverse-surface/40 backdrop-blur-xs flex items-center justify-center p-space-md"
             id="quick-log-modal">
            <div class="bg-surface-container-lowest border-2 border-on-surface max-w-lg w-full p-space-xl flex flex-col gap-space-lg">
                <div class="flex items-center justify-between border-b border-outline-variant pb-space-sm">
                    <div class="flex items-center gap-space-xs">
                        <span class="material-symbols-outlined text-primary">add_box</span>
                        <span class="font-headline-md text-headline-md text-on-surface">Log New Solve Entry</span>
                    </div>
                    <button class="text-secondary hover:text-on-surface focus:outline-none focus:ring-1 focus:ring-primary p-1"
                            id="close-log-modal">
                        <span class="material-symbols-outlined text-base">close</span>
                    </button>
                </div>
                <div class="flex flex-col gap-space-md">
                    <div class="flex flex-col gap-space-xs">
                        <label class="font-label-sm text-label-sm text-secondary uppercase">Puzzle Reference or
                            URL</label>
                        <input class="w-full bg-surface-cream border border-on-surface px-space-md py-space-sm font-label-md text-label-md text-on-surface focus:outline-none focus:border-primary"
                               placeholder="https://crackingthecryptic.com/play/..." type="text"/>
                    </div>
                    <div class="grid grid-cols-2 gap-space-md">
                        <div class="flex flex-col gap-space-xs">
                            <label class="font-label-sm text-label-sm text-secondary uppercase">Solve Time
                                (mm:ss)</label>
                            <input class="w-full bg-surface-cream border border-on-surface px-space-md py-space-sm font-label-md text-label-md text-on-surface focus:outline-none focus:border-primary"
                                   placeholder="28:45" type="text"/>
                        </div>
                        <div class="flex flex-col gap-space-xs">
                            <label class="font-label-sm text-label-sm text-secondary uppercase">Assessed
                                Difficulty</label>
                            <select class="w-full bg-surface-cream border border-on-surface px-space-md py-space-sm font-label-md text-label-md text-on-surface focus:outline-none focus:border-primary">
                                <option>Easy</option>
                                <option selected="">Medium</option>
                                <option>Hard</option>
                                <option>Diabolical</option>
                            </select>
                        </div>
                    </div>
                    <div class="flex flex-col gap-space-xs">
                        <label class="font-label-sm text-label-sm text-secondary uppercase">Deduction Notes</label>
                        <textarea
                                class="w-full bg-surface-cream border border-on-surface px-space-md py-space-sm font-body-sm text-body-sm text-on-surface focus:outline-none focus:border-primary"
                                placeholder="Key logic breakthroughs or bottlenecks..." rows="3"></textarea>
                    </div>
                </div>
                <div class="flex items-center justify-end gap-space-sm pt-space-sm border-t border-outline-variant">
                    <button class="font-label-md text-label-md px-space-lg py-space-sm border border-outline text-on-surface hover:bg-surface-container"
                            id="cancel-log-modal">
                        Cancel
                    </button>
                    <button class="font-label-md text-label-md px-space-lg py-space-sm bg-primary text-on-primary hover:bg-inverse-surface">
                        Commit Solve
                    </button>
                </div>
            </div>
        </div>
        <script>
            (function () {
                const openBtn = document.getElementById('quick-log-btn');
                const modal = document.getElementById('quick-log-modal');
                const closeBtn = document.getElementById('close-log-modal');
                const cancelBtn = document.getElementById('cancel-log-modal');

                if (openBtn && modal) {
                    openBtn.addEventListener('click', function () {
                        modal.classList.remove('hidden');
                    });
                }

                function closeModal() {
                    if (modal) modal.classList.add('hidden');
                }

                if (closeBtn) closeBtn.addEventListener('click', closeModal);
                if (cancelBtn) cancelBtn.addEventListener('click', closeModal);
            })();
        </script>
        </main>

{% endblock %}
        