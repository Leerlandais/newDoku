{% extends 'template.html.twig' %}
{% block title %}{{ parent() }}Results{% endblock %}

{% block content %}

    <section class="flex flex-col md:flex-row md:items-end justify-between gap-space-lg">
        <div class="flex flex-col gap-space-xs max-w-2xl">
            <h1 class="font-headline-xl text-headline-xl text-on-surface tracking-tight">
                Search Puzzle Archive
            </h1>
            <span class="font-headline-md text-headline-md text-on-surface">{{ systemMessage ? systemMessage : "" }}</span>
        </div>
        <!-- Quick Stats Callout -->
        <div class="flex items-center gap-space-md bg-surface-container-low px-space-lg py-space-sm shadow-sm self-start md:self-auto">

            <div class="w-px h-8 bg-outline-variant"></div>
        </div>
    </section>
<!-- Instant Search Results Section -->
<section class="flex flex-col gap-space-md">
    <!-- Ledger Head Controls & Metric -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-space-sm bg-surface-container-low px-space-lg py-space-md">

        <div class="flex items-center gap-space-md">
            <span class="font-label-sm text-label-sm text-secondary">SORTED BY: DATE SOLVED (DESC)</span>

        </div>
    </div>
    <!-- High-Density Vision-Friendly Data Table -->
    <div class="w-full overflow-x-auto shadow-sm bg-surface-cream">
        <table class="w-full text-left border-collapse" id="archiveResultsTable">
            <thead>
            <tr class="bg-surface-container text-secondary font-label-sm text-label-sm tracking-wider uppercase">
                <th class="py-space-md px-space-lg">ID</th>
                <th class="py-space-md px-space-lg">Puzzle Designation</th>
                <th class="py-space-md px-space-lg">Setter</th>
                <th class="py-space-md px-space-lg">Variants</th>
                <th class="py-space-md px-space-lg text-right">Solve Time</th>
                <th class="py-space-md px-space-lg text-right">Log Date</th>
                <th class="py-space-md px-space-lg text-center">Details</th>
            </tr>
            </thead>
            <tbody class="divide-y-0 font-body-sm text-body-sm text-on-surface" id="resultsBody">
            {% for puzzle in puzzles %}
                <tr class="hover:bg-surface-cream/80 transition-colors group bg-surface-container-low/40">
                    <td class="py-space-md px-space-lg border-r border-outline-variant font-label-md text-label-md text-on-surface-variant group-hover:text-primary font-semibold">
                        {{ puzzle.getDokuId }}
                    </td>
                    <td class="py-space-md px-space-lg border-r border-outline-variant">
                        <div class="flex flex-col">
                            <div class="flex items-center gap-space-xs">
                                <span class="font-headline-md text-base font-semibold text-on-surface leading-snug">{{ puzzle.getDokuTitle }}</span>
                                {% if puzzle.getDokuDuration > 35 %}
                                    <span class="font-label-sm text-label-sm px-1.5 py-0.2 bg-tertiary-fixed text-on-tertiary-fixed font-medium">HARD</span>
                                {% elseif puzzle.getDokuDuration < 18 %}
                                    <span class="font-label-sm text-label-sm px-1.5 py-0.2 bg-green-200 text-on-tertiary-fixed font-medium">EASY</span>
                                {% endif %}
                            </div>
                        </div>
                    </td>
                    <td class="py-space-md px-space-lg border-r border-outline-variant">
                        <div class="flex flex-wrap gap-1.5">
                            <span class="font-label-sm text-label-sm px-space-xs py-0.5 border border-outline-variant bg-surface text-on-surface">{{ puzzle.getDokuSetterName }}</span>
                        </div>
                    </td>
                    <td class="py-space-md px-space-lg border-r border-outline-variant">
                        <div class="flex flex-wrap gap-1.5">
                            <span class="font-label-sm text-label-sm px-space-xs py-0.5 border border-outline-variant bg-surface text-on-surface">{{ puzzle.getDokuVariantNames }}</span>
                        </div>
                    </td>
                    <td class="py-space-md px-space-lg border-r border-outline-variant">
                        <div class="flex flex-wrap gap-1.5">
                            <span class="font-label-sm text-label-sm px-space-xs py-0.5 border border-outline-variant bg-surface text-on-surface">{{ puzzle.getDokuDuration }}</span>
                        </div>
                    </td>
                    <td class="py-space-md px-space-lg border-r border-outline-variant font-grid-digit-sm text-label-md font-semibold  text-on-surface">
                        {{ puzzle.getDokuDate|date("d/m") }}
                    </td>
                    <td class="py-space-md px-space-lg text-center">
                        <a href="#"><span class="material-symbols-outlined text-secondary group-hover:text-primary transition-colors text-lg">arrow_forward</span></a>
                    </td>
                </tr>

            {% endfor %}
            </tbody>
        </table>
    </div>
    <!-- Pagination & Bottom Ledger Foot -->
    {% if foundPuzzles == false %}
    <div class="flex flex-col sm:flex-row items-center justify-between gap-space-md pt-space-xs">
<span class="font-label-sm text-label-sm text-secondary">
          Displaying rows 1 – 5 of 18 archived solves
        </span>
        <div class="flex items-center gap-space-xs">
            <button class="font-label-sm text-label-sm px-space-md py-space-xs bg-surface-container text-outline opacity-50 cursor-not-allowed" disabled="" type="button">PREV</button>
            <span class="font-label-sm text-label-sm px-space-md py-space-xs bg-primary-container text-on-primary">1</span>
            <button class="font-label-sm text-label-sm px-space-md py-space-xs bg-surface-container text-on-surface hover:bg-surface-container-high transition-colors" type="button">2</button>
            <button class="font-label-sm text-label-sm px-space-md py-space-xs bg-surface-container text-on-surface hover:bg-surface-container-high transition-colors" type="button">3</button>
            <button class="font-label-sm text-label-sm px-space-md py-space-xs bg-surface-container text-on-surface hover:bg-surface-container-high transition-colors" type="button">4</button>
            <button class="font-label-sm text-label-sm px-space-md py-space-xs bg-surface-container text-on-surface hover:bg-surface-container-high transition-colors" type="button">NEXT</button>
        </div>
    </div>
    {% endif %}
</section>


{% endblock %}
