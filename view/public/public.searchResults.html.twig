{% extends 'template.html.twig' %}
{% block title %}{{ parent() }}Results{% endblock %}
{% block dumpArea %}
{% endblock %}
{% block content %}

{% set nothingFound %}
    <div class="p-space-xl flex flex-col items-center justify-center text-center bg-surface-container-low/40">
        <div class="w-12 h-12 flex items-center justify-center bg-surface-container text-secondary mb-space-sm">
            <span class="material-symbols-outlined text-2xl">event_busy</span>
        </div>
        <p class="font-headline-md text-headline-md text-on-surface mb-space-xs">
            Nothing found using those parameters.
        </p>
    </div>
{% endset %}

    <!-- 6 Segmented Table Layout -->
    <section class="w-full px-margin pb-space-xl">
        <div class="max-w-7xl mx-auto flex flex-col gap-space-lg">
            <!-- CREATE A VARIABLE SEARCH_OPTIONS -->
            <article class="bg-surface-cream shadow-sm flex flex-col overflow-hidden">
                <header class="bg-surface-container-low px-space-md py-space-sm flex flex-wrap items-center justify-between gap-space-sm">
                    <div class="flex items-center gap-space-sm">
                        <span class="font-label-sm text-label-sm bg-primary text-on-primary px-space-xs py-0.5 uppercase tracking-wider font-semibold">01</span>
                        <h2 class="font-headline-md text-headline-md text-on-surface">Puzzles found by Name</h2>
                    </div>
                </header>
                {% if puzzles["byTitle"] %}
                    <div class="overflow-x-auto">
                        <table class="w-full text-left font-body-sm text-body-sm">
                            <thead>
                            <tr class="bg-surface-container-lowest text-secondary font-label-sm text-label-sm uppercase tracking-wider">
                                <th class="py-space-sm px-space-md" scope="col">Puzzle ID</th>
                                <th class="py-space-sm px-space-md" scope="col">Title &amp; Setter</th>
                                <th class="py-space-sm px-space-md" scope="col">Variant Tags</th>
                                <th class="py-space-sm px-space-md" scope="col">Solve Time / Metric</th>
                                <th class="py-space-sm px-space-md text-right" scope="col">Action</th>
                            </tr>
                            </thead>
                            <tbody>
                            {% for puzzle in puzzles["byTitle"] %}
                                <tr class="hover:bg-surface-container-low/60 transition-colors">
                                    <td class="py-space-md px-space-md font-label-md text-label-md text-primary font-semibold whitespace-nowrap">
                                        &num; {{ puzzle.getDokuId }}
                                    </td>
                                    <td class="py-space-md px-space-md">
                                        <div class="flex flex-col">
                                            <span class="font-headline-md text-headline-md text-on-surface leading-tight">{{ puzzle.getDokuTitle }}</span>
                                            <span class="font-body-sm text-body-sm text-secondary">Setter: {{ puzzle.getDokuSetterName }}</span>
                                        </div>
                                    </td>
                                    <td class="py-space-md px-space-md">
                                        <div class="flex flex-wrap gap-space-xs">
                                            <a href="?route=showVariantRules" class="span-extra">{{ puzzle.getDokuVariantNames }}</a>
                                        </div>
                                    </td>
                                    <td class="py-space-md px-space-md font-label-md text-label-md text-on-surface font-semibold whitespace-nowrap">
                                <span class="inline-flex items-center gap-space-xs text-secondary font-normal mr-1">
                                <span class="material-symbols-outlined text-sm">timer</span>
                                </span>
                                        {{ puzzle.dokuDuration }}m
                                    </td>
                                    <td class="py-space-md px-space-md text-right whitespace-nowrap">
                                        <a class="inline-flex items-center gap-1 font-label-md text-label-md text-primary hover:text-on-surface transition-colors focus:ring-2 focus:ring-primary focus:ring-offset-2 px-space-sm py-1 bg-surface-container"
                                           href="?route=showDetails&id={{ puzzle.getDokuId }}">
                                            Details
                                            <span class="material-symbols-outlined text-sm">arrow_forward</span>
                                        </a>
                                    </td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>

                {% else %}
                    {{ nothingFound }}
                {% endif %}
            </article>

            <!-- Table 2: Puzzles found by Setter -->
            <article class="bg-surface-cream shadow-sm flex flex-col overflow-hidden">
                <header class="bg-surface-container-low px-space-md py-space-sm flex flex-wrap items-center justify-between gap-space-sm">
                    <div class="flex items-center gap-space-sm">
                        <span class="font-label-sm text-label-sm bg-primary text-on-primary px-space-xs py-0.5 uppercase tracking-wider font-semibold">02</span>
                        <h2 class="font-headline-md text-headline-md text-on-surface">Puzzles found by Setter</h2>
                    </div>
                </header>
            {% if puzzles["bySetter"] %}
                <div class="overflow-x-auto">
                    <table class="w-full text-left font-body-sm text-body-sm">
                        <thead>
                        <tr class="bg-surface-container-lowest text-secondary font-label-sm text-label-sm uppercase tracking-wider">
                            <th class="py-space-sm px-space-md" scope="col">Puzzle ID</th>
                            <th class="py-space-sm px-space-md" scope="col">Title &amp; Setter</th>
                            <th class="py-space-sm px-space-md" scope="col">Variant Tags</th>
                            <th class="py-space-sm px-space-md" scope="col">Solve Time / Metric</th>
                            <th class="py-space-sm px-space-md text-right" scope="col">Action</th>
                        </tr>
                        </thead>
                        <tbody>
                        {% for puzzle in puzzles["bySetter"] %}
