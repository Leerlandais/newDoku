{% extends "template.html.twig" %}
    {% block dumpArea %}

    {% endblock %}
    {% block title %}{{ parent() }}Details{% endblock %}
{% block content %}
    <main class="w-full pt-20 bg-surface min-h-[calc(100vh-5rem)]">
        <div class="flex flex-col w-full">
            <!-- Top Context / Breadcrumbs Bar -->

            <!-- Editorial Header Card -->
            <section class="w-full bg-surface px-margin pt-space-lg pb-space-md">
                <div class="max-w-7xl mx-auto bg-surface-container-lowest p-space-lg shadow-sm">
                    <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-space-lg">
                        <!-- Title & Metadata -->
                        <div class="flex flex-col gap-space-xs">
                            <div class="flex items-center gap-space-sm flex-wrap">
                                <span class="font-label-sm text-label-sm bg-surface-container text-on-surface px-2 py-0.5 uppercase tracking-wider">Sudoku Variant</span>
                                    {% set stars = puzzle.getDokuStars ?? 0 %}
                                {% if stars %}
                                <span class="font-label-sm text-label-sm bg-tertiary-container text-on-tertiary px-2 py-0.5 uppercase tracking-wider">Difficulty :</span>
                                <div class="flex items-center text-tertiary text-sm" title="Difficulty: 4 of 5">

                                    {% if stars > 5 %}
                                        {% set stars = 5 %}
                                    {% endif %}
                                    {% for i in range(1, stars) %}
                                    <span class="material-symbols-outlined text-sm"
                                          style="font-variation-settings: 'FILL' 1;">star</span>
                                    {% endfor %}
                                    {% if stars < 5 %}
                                    {% for j in range(1, (5 - stars)) %}
                                    <span class="material-symbols-outlined text-sm text-outline-variant">star</span>
                                    {% endfor %}
                                    {% endif %}
                                    <span class="font-label-sm text-label-sm text-secondary ml-1.5 font-semibold">{{ stars }} / 5</span>
                                </div>
                                {% endif %}
                                {% if "ROLE_SUPER" in sessionRole %}
                                    <form method="post">
                                        <label>
                                            <select name="int:doku_stars">
                                                <option selected disabled></option>
                                                <option value="1">1</option>
                                                <option value="2">2</option>
                                                <option value="3">3</option>
                                                <option value="4">4</option>
                                                <option value="5">5</option>
                                            </select>
                                        </label>
                                        <button type="submit" name="unset:updateStars">Go</button>
                                    </form>
                                {% endif %}
                            </div>
                            <a href="{{ puzzle.getDokuUrl }}" target="_blank"><h1 class="h1-style">{{ puzzle.getDokuTitle }}</h1></a>
                            <div class="flex items-center gap-space-md text-secondary font-label-md text-label-md flex-wrap pt-1">
                                <span>Setter: <strong
                                            class="text-on-surface font-semibold">{{ puzzle.getDokuSetterName }}</strong></span>
                                <span>•</span>
                                <span>Solved: <strong
                                            class="text-on-surface font-semibold">{{ puzzle.getDokuDate|date("d/m") }}</strong></span>
                                <span>•</span>
                                <span class="flex items-center gap-1">
<span class="material-symbols-outlined text-sm text-primary">timer</span>
              Solve Time: <strong class="text-primary font-semibold">{{ puzzle.getDokuDuration }} minutes</strong>
</span>
                            </div>
                        </div>
                        <!-- Primary CTC CTA -->
                        <div class="flex items-center gap-space-sm self-start lg:self-center">
                            {% if "ROLE_SUPER" in sessionRole and puzzle.getDokuImgLocation|length < 1 %}
                                <div class="flex flex-col items-center justify-center h-3/6">
                                    <form method="post" enctype="multipart/form-data" class="flex flex-col gap-y-4">
                                        <label>
                                            <input type="hidden" name="csrf:csrf_token" value="{{ csrf_token }}">
                                        </label>
                                        Choose an image to upload :
                                        <input type="file" name="fileToUpload" id="fileToUpload" required>
                                        <label for="altText" class="label-bold">Alt Text : </label>
                                        <input type="text" name="altText" id="altText" class="input-style index-shadow-input
                                      input-fx h-10 w-[300px] lg:w-[460px] px-2.5 mb-1" required value="{{ puzzle.getDokuTitle }}">
                                        <input type="submit"
                                               value="Upload Image"
                                               class="inline-flex items-center justify-center gap-space-xs bg-primary-container text-on-primary font-label-md text-label-md px-space-lg py-space-sm hover:bg-inverse-surface transition-colors focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2">
                                    </form>
                                </div>
                            {% endif %}
                            <a class="inline-flex items-center justify-center gap-space-xs bg-primary-container text-on-primary font-label-md text-label-md px-space-lg py-space-sm hover:bg-inverse-surface transition-colors focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2"
                               href="{{ puzzle.getDokuUrl }}" rel="noopener noreferrer" target="_blank">
                                <span>Play on CTC Web App</span>
                                <span class="material-symbols-outlined text-base">open_in_new</span>
                            </a>
                        </div>
                    </div>
                </div>
            </section>
            <!-- Two-Column Master View -->
            <section class="w-full px-margin pb-space-xl">
                <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-space-lg items-start">
                    <!-- LEFT COLUMN: Grid Diagram & Actions (5 Columns) -->
                    <aside class="lg:col-span-5 flex flex-col gap-space-md">
                        <!-- Visual Diagram Card -->
                        <div class="bg-surface-container-lowest p-space-md shadow-sm">
                            <div class="flex items-center justify-between pb-space-xs mb-space-sm bg-surface-container-low px-space-sm py-1.5">
                                <span class="font-label-sm text-label-sm text-secondary uppercase font-semibold">Grid Schematic</span>
                                <span class="font-label-sm text-label-sm text-primary">9 × 9 CLASSIC FRAME</span>
                            </div>
                            <!-- The Given Puzzle Image -->
                            <div class="w-full aspect-square bg-surface-cream overflow-hidden p-2">
                                <a href="{{ puzzle.getDokuUrl }}" target="_blank"><img alt="Image for {{ puzzle.getDokuTitle }} missing"
                                     class="w-full h-full select-none"
                                     src="{{ IMG_DIR }}/{{ puzzle.getDokuImgLocation }}.png"/>
                                </a>
                            </div>
                            -
                        </div>
                        <!-- Action Panel -->
                        <div class="bg-surface-container-lowest p-space-md shadow-sm flex flex-col gap-space-xs">
                            <h2 class="font-label-md text-label-md text-on-surface font-semibold uppercase tracking-wider mb-space-xs">
                                Solver Toolkit</h2>
                            <a class="w-full inline-flex items-center justify-between px-space-md py-space-sm bg-surface-container-low text-on-surface font-label-md text-label-md hover:bg-surface-container transition-colors focus:outline-none focus:ring-2 focus:ring-primary"
                               href="{{ puzzle.getDokuUrl }}" rel="noopener noreferrer" target="_blank">
<span class="flex items-center gap-space-xs">
<span class="material-symbols-outlined text-primary text-base">replay</span>
              Replay Puzzle on CTC
            </span>
                                <span class="material-symbols-outlined text-secondary text-sm">arrow_forward</span>
                            </a>
                            <button class="w-full inline-flex items-center justify-between px-space-md py-space-sm bg-surface-container-low text-on-surface font-label-md text-label-md hover:bg-surface-container transition-colors focus:outline-none focus:ring-2 focus:ring-primary"
                                    onclick="window.print()" type="button">
<span class="flex items-center gap-space-xs">
<span class="material-symbols-outlined text-primary text-base">print</span>
              Download Printable Grid (PDF)
            </span>
                                <span class="material-symbols-outlined text-secondary text-sm">download</span>
                            </button>

                            <div class="hidden font-label-sm text-label-sm text-primary bg-primary-fixed/20 p-space-xs text-center mt-1"
                                 id="exportAlert">
                                Solve notes exported to clipboard successfully.
                            </div>
                        </div>
                        <!-- Quick Stats Breakdown -->
                        <div class="bg-surface-container-lowest p-space-md shadow-sm">
                            <h3 class="font-label-sm text-label-sm text-secondary uppercase font-semibold mb-space-sm">
                                Solver Benchmarks</h3>
                            <div class="grid grid-cols-2 gap-space-sm">
                                <div class="bg-surface-container-low p-space-sm">
                                    <span class="font-label-sm text-label-sm text-secondary block">My average</span>
                                    <span class="span-style font-semibold">{{ averageTime }} minutes</span>
                                </div>

                                <div class="bg-surface-container-low p-space-sm">
                                    <span class="font-label-sm text-label-sm text-secondary block">Difference</span>
                                    <span class="font-headline-md text-headline-md text-primary font-semibold">{{ (puzzle.getDokuDuration - averageTime)|round(2, "ceil") }} minutes</span>
                                </div>
                            </div>
                        </div>
                    </aside>
                    <!-- RIGHT COLUMN: Rules Specifications & Spoiler Logic (7 Columns) -->
                    <div class="lg:col-span-7 flex flex-col gap-space-md">
                        <!-- Specifications & Rules Card -->
                        <div class="bg-surface-container-lowest p-space-lg shadow-sm">
                            <div class="flex items-center justify-between pb-space-sm mb-space-md bg-surface-container-low px-space-md py-2">
                                <h2 class="span-style font-semibold">Puzzle
                                    Specifications</h2>
                                <span class="font-label-sm text-label-sm text-secondary">VARIANT HYBRID</span>
                            </div>
                            <!-- Variant Chips -->
                            <div class="flex flex-wrap gap-space-xs mb-space-md">
                                {% for variant in puzzle.getDokuVariantNames|split(', ') %}
                                    <span class="font-label-sm text-label-sm bg-surface-container text-on-surface font-semibold px-space-sm py-1">{{ variant }}</span>
                                {% endfor %}
                            </div>
                            <!-- Detailed Rules Accordion / Narrative -->
                            <div class="space-y-space-md">
                                <div>
                                    <h3 class="font-label-md text-label-md text-primary font-semibold uppercase tracking-wide flex items-center gap-1.5 mb-1">
                                        <span class="material-symbols-outlined text-sm">check_circle</span>
                                        Classic Sudoku Rules
                                    </h3>
                                    <p class="font-body-md text-body-md text-on-surface-variant leading-relaxed">
                                        Place the digits 1 through 9 once each in every row, column, and 3x3 box without
                                        repetition.
                                    </p>
                                </div>
                                {% for variant in variants %}
                                    {% if variant.getVariantName in puzzle.getDokuVariantNames %}
                                        <div>
                                            <a  href="?route=getVariant&id={{ variant.getVariantId }}" class="font-label-md text-label-md text-primary font-semibold uppercase tracking-wide flex items-center gap-1.5 mb-1">
                                                <span class="material-symbols-outlined text-sm">linear_scale</span>
                                                {{ variant.getVariantName }}
                                            </a>
                                            <p class="font-body-md text-body-md text-on-surface-variant leading-relaxed">
                                                {{ variant.getVariantRules }}
                                            </p>
                                        </div>
                                    {% endif %}
                                {% endfor %}
                            </div>
                        </div>
                        <!-- SPOILERS & LOGICAL BREAKTHROUGHS SECTION -->
                        <div class="bg-surface-container-lowest p-space-lg shadow-sm flex flex-col gap-space-md">
                            <div class="flex items-center justify-between flex-wrap gap-space-xs">
                                <h2 class="span-style font-semibold">Logic
                                    Breakthroughs</h2>
                                <button class="font-label-sm text-label-sm text-primary hover:text-inverse-surface underline underline-offset-4 focus:outline-none focus:ring-2 focus:ring-primary"
                                        onclick="revealAllClues()" type="button">
                                    Reveal All Hints
                                </button>
                            </div>
                            <!-- Warning Banner -->
                            <div class="bg-error-container text-on-error-container p-space-md flex items-start gap-space-sm">
                                <span class="material-symbols-outlined text-error text-xl shrink-0 mt-0.5">warning</span>
                                <div class="flex flex-col">
<span class="font-label-md text-label-md font-semibold text-error uppercase tracking-wide">
                Spoilers Ahead
              </span>
                                    <p class="p-style">
                                        The sections below reveal slight to major spoilers...
                                    </p>
                                    <p class="p-style">
                                        - 1: A nudge: "Look at this cell, or row/whatever. How is it interacting with this, other, cell?", or some other, gentle hint</p>
                                    <p class="p-style">
                                        - 2: A bit more: "Still gentle but bigger than a nudge"</p>
                                    <p class="p-style">
                                        - 3: A clear definition of what was previously implied</p>
                                    <p class="p-style">
                                        - 4: Borderline : Look at your own risk</p>
                                    <p class="p-style">
                                        - 5: The major solve explanations: HUGE spoilers</p>


                                </div>
                            </div>
                            <!-- Collapsible Clue Items -->
                            <div class="flex flex-col gap-space-sm">

                                {% if clues < 1 %}
                                    <div class="bg-surface-container-low p-space-md transition-colors">
                                        <div class="flex items-center justify-between gap-space-md">
                                            <div class="flex items-center gap-space-sm">
                                                <span class="font-label-md text-label-md font-semibold text-on-surface">
                                                    No clues added just yet. Sorry, these things take time
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                    {% else %}
                                <!-- Clue 1 -->
                                        {% for clue in clues %}
                                <div class="bg-surface-container-low p-space-md transition-colors">
                                    <div class="flex items-center justify-between gap-space-md">
                                        <div class="flex items-center gap-space-sm">
                                            <span class="font-label-sm text-label-sm bg-surface-container px-2 py-0.5 text-on-surface font-bold">{{ clue.getClueLevel }} : {{ clue.getClueHeader }}</span>
                                  {#           <span class="font-label-md text-label-md font-semibold text-on-surface">The Break-in Step (Row 1 &amp; Row 9 Parity)</span> #}
                                        </div>
                                        <button aria-expanded="false"
                                                class="font-label-sm text-label-sm px-space-md py-space-xs bg-surface-container hover:bg-primary hover:text-on-primary text-on-surface transition-colors focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-1"
                                                onclick="toggleClue('clue-{{ clue.getClueId }}', this)" type="button">
                                            Reveal Step
                                        </button>
                                    </div>
                                    <div class="hidden mt-space-md pt-space-sm bg-surface-container-lowest p-space-md font-body-sm text-body-sm text-on-surface-variant leading-relaxed"
                                         id="clue-{{ clue.getClueId }}">
                                        <p class="mb-2">
                                            {# <strong class="text-primary font-medium">Parity Segregation:</strong> #}
                                            {{ clue.getClueText }}
                                        </p>
                                    </div>
                                </div>
                                        {% endfor %}
                                {% endif %}
                                {% if "ROLE_SUPER" in sessionRole %}

                                <div class="flex-1 max-w-3xl w-full mx-auto px-6 py-8">
                                    <!-- Page Heading & Context -->


                                    <!-- Clue Submission Form -->
                                    <form method="POST" class="bg-surface-card border border-border rounded-lg shadow-sm overflow-hidden font-sans">

                                        <div class="p-6 md:p-8 space-y-6">
                                            <!-- 1. clue_level -->
                                            <div>
                                                <div class="flex items-baseline justify-between mb-2">
                                                    <label for="clue_level" class="block text-xs font-mono uppercase font-bold text-text tracking-wider">
                                                        Clue Level <span class="text-primary">*</span>
                                                    </label>
                                                </div>

                                                <div class="relative">
                                                    <select id="clue_level"
                                                            name="int:clue_level"
                                                            required
                                                            class="w-full px-4 py-2.5 bg-white border border-border rounded text-text font-mono text-sm focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary transition-colors appearance-none cursor-pointer">
                                                        <option value="" disabled selected>Select clue severity level...</option>
                                                        <option value="1">Level 1 — Gentle Nudge (Point towards a specific row, box, or variant line)</option>
                                                        <option value="2">Level 2 — Focused Observation (Highlight candidate restriction or parity balance)</option>
                                                        <option value="3">Level 3 — Significant Breakthrough (Key deduction unlocking several cells)</option>
                                                        <option value="4">Level 4 — Critical Bottleneck / Break-in (Primary core solve deduction)</option>
                                                        <option value="5">Level 5 — Full Resolution Step (Exact digits &amp; chain walkthrough)</option>
                                                    </select>
                                                    <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-3 text-text-muted font-mono text-xs">
                                                        ▼
                                                    </div>
                                                </div>

                                            </div>


                                            <!-- 3. clue_description -->
                                            <div>
                                                <div class="flex items-baseline justify-between mb-2">
                                                    <label for="clue_header" class="block text-xs font-mono uppercase font-bold text-text tracking-wider">
                                                        Clue Header <span class="text-primary">*</span>
                                                    </label>
                                                    <input type="text" id="clue_header" name="str:clue_header" class="border border-gray-300 rounded-md px-2 py-1">

                                                </div>
                                                <div class="flex items-baseline justify-between mb-2">
                                                    <label for="clue_description" class="block text-xs font-mono uppercase font-bold text-text tracking-wider">
                                                        Clue Description <span class="text-primary">*</span>
                                                    </label>

                                                </div>

                                                <textarea id="clue_description"
                                                          name="str:clue_text"
                                                          rows="6"
                                                          required
                                                          class="w-full px-4 py-3 bg-white border border-border rounded text-text font-sans text-sm focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary transition-colors placeholder:text-text-muted/60 leading-relaxed"></textarea>
                                            </div>
                                        </div>
                                        <!-- Form Actions -->
                                        <div class="px-6 md:px-8 py-4 bg-slate-50 border-t border-border flex flex-col sm:flex-row items-center justify-between gap-4 font-mono text-xs">
                                            <div class="flex items-center gap-3 w-full sm:w-auto order-1 sm:order-2">
                                                <input type="hidden" name="int:clue_doku_id" value="{{ puzzle.getDokuId }}">
                                                <input type="hidden" name="csrf:csrf_token" value="{{ csrfToken }}">
                                                <button type="submit" class="w-1/2 sm:w-auto px-6 py-2.5 bg-primary text-white font-bold rounded hover:bg-primary-dark transition-colors shadow-sm focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2"
                                                        name="unset:addClue">
                                                    + Save Clue Deduction
                                                </button>
                                            </div>
                                        </div>
                                    </form>
                                </div>
                                {% endif %}
                                    </div>
                                </div>


                        <!-- Solve Log Meta Info Footer -->
                        <div class="bg-surface-container-low p-space-md flex flex-wrap items-center justify-between gap-space-md">

                            <div class="flex items-center gap-space-xs">
                                <button class="font-label-sm text-label-sm text-secondary hover:text-on-surface px-2 py-1"
                                        type="button">Previous (#SUD-2840)
                                </button>
                                <span class="text-outline-variant">/</span>
                                <button class="font-label-sm text-label-sm text-primary font-semibold hover:text-on-surface px-2 py-1"
                                        type="button">Next (#SUD-2842)
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        </div>
    </main>

{% endblock %}
    {% block javascript %}
    {{ parent() }}
    <script src="{{ PUB_DIR }}scripts/detailPageHandler.js"></script>
{% endblock %}
