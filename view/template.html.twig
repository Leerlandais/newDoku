{% extends 'base.html.twig' %}
{% block stylesheet %}
    <link href="../dist/tailwind.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com" rel="preconnect"/>
    <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect"/>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&amp;family=JetBrains+Mono:wght@500;600&amp;family=Space+Grotesk:wght@500;600&amp;display=swap"
          rel="stylesheet"/>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200"
          rel="stylesheet"/>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap"
          rel="stylesheet"/>
{% endblock %}
{% block title %}The Variant Log | {% endblock %}
{% block bodyClass %}bg-gray-200{% endblock %}

{% block header %}
    {% include "inc/_header.html.twig" %}
    <span class="hidden" id="sessionExpiresAt">{{ sessionExpiresAt * 1000 }}</span>
{% endblock %}
    {% block systemMessage %}
        <div id="systemMessageModal"
             class="fixed inset-0 bg-black bg-opacity-50 flex items-start pt-24 justify-center {{ systemMessage ? "" : "hidden" }} z-50">
            <div class="bg-blue-100 rounded-2xl p-6 max-w-lg w-full shadow-2xl relative">
                <button id="closeMessageModal"
                        class="absolute top-3 right-3 text-gray-500 hover:text-gray-800 text-2xl font-bold">
                    &times;
                </button>
                <p class="text-base text-gray-700 text-center">
                    {{ systemMessage|nl2br }}
                </p>
            </div>
        </div>
    {% endblock %}

{% block footer %}
    <footer class="border-t border-border bg-surface-card py-4 text-xs font-mono text-text-muted mt-auto">
        <div class="max-w-7xl mx-auto px-6 flex flex-col sm:flex-row items-center justify-center gap-4">
            <div class="flex items-center gap-4">
                <span>© {{ date|date(("Y")) }} THE VARIANT LOG by Leerlandais</span>
                <span class="text-border">|</span>
                <a href="https://crackingthecryptic.com/latest" target="_blank" class="hover:text-primary underline">CTC Latest</a>
                <a href="https://crackingthecryptic.com/sudokus" target="_blank" class="hover:text-primary underline">CTC Archive</a>
            </div>
        </div>
    </footer>
{% endblock %}

{% block javascript %}
<script src="{{ PUB_DIR }}scripts/tableSorter.js"></script>
<script src="{{ PUB_DIR }}scripts/systemModalHandler.js"></script>
<script src="{{ PUB_DIR }}scripts/pageRefresher.js"></script>
{% endblock %}
