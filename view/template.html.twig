          rel="stylesheet"/>
{% endblock %}
{% block title %}The Variant Log | {% endblock %}
{% block bodyClass %}bg-gray-200{% endblock %}
{% block header %}

        <div class="h-20 w-full px-margin flex items-center justify-between gap-gutter">
            <div class="flex items-center gap-space-md"><img alt="Cryptic Log Brand Mark"
                                                             class="h-8 w-auto object-contain"
