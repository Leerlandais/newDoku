                <div class="flex flex-col"><span
                            class="font-headline-md text-headline-md text-on-surface tracking-tight leading-none">The Variant Log</span><span
                            class="font-label-sm text-label-sm text-secondary tracking-wider uppercase mt-space-xs">Cracking The Cryptic Solver Journal</span>
                </div>
            </div>
            <nav class="hidden lg:flex items-center gap-space-xs"
                 data-active-classes="bg-primary-container text-on-primary font-semibold"><a
