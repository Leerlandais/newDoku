{% extends "template.html.twig" %}

{% block title %}{{ parent() }} Logs{% endblock %}
{% block dumpArea %}

{% endblock %}
{% block content %}
    {% if logs %}
        <div class="overflow-scroll max-h-[500px]">
            <h1 class="h1-style">Total Connections : {{ logCount }}</h1>
            <table class="min-w-full bg-white shadow-md rounded-xl border border-gray-300
                  max-h-[500px] overflow-scroll text-center"
                   id="logTable">
                <thead>
                <tr class="bg-blue-gray-100 text-center text-gray-700">
                    <th class="py-3 px-4 cursor-pointer">Date</th>
                    <th class="py-3 px-4 cursor-pointer">IP</th>
                    <th class="py-3 px-4 cursor-pointer">Page</th>
                </tr>
                </thead>
                <tbody class="text-blue-gray-900">

                {% for log in logs %}
                    <tr class="border-b border-blue-gray-200">

                        <td class="py-3 px-4">{{ log.getLogDate|date("d/m H:i:s") }}</td>
                        <td class="py-3 px-4"><a href="?route=showLogs&ip={{ log.getLogIp }}">{{ log.getLogIp }}</a><a
                                    href="https://myip.ms/info/whois/{{ log.getLogIp }}" target="_blank"><span class="material-symbols-outlined text-base ms-4">open_in_new</span></a></td>
                        <td class="py-3 px-4"><a href="?route=showDetails&id={{ log.getLogUrl }}">{{ log.getLogPageVisited == 0 ? "Home" : log.getLogPageVisited }}</a></td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
            <a class="font-label-md text-label-md bg-surface-container-low text-on-surface px-space-lg py-space-sm border border-outline-variant hover:bg-surface-container transition-all flex items-center gap-space-xs focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2"
               id="quick-log-btn" href="?route=viewLog&attempt=1">
                <span class="material-symbols-outlined text-base text-primary">add_box</span>
                <span>View Login Attempts</span>
            </a>
        </div>
    {% else %}
        <h2 class="h2-center mt-12">No logs available</h2>
    {% endif %}
{% endblock %}
