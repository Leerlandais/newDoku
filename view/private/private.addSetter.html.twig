{% extends "template.html.twig" %}
{% block title %}{{ parent() }} | Add Setter{% endblock %}
{% block content %}
    <h2 class="h2-center">There are currently {{ setters|length }} setters</h2>
    <div class="w-1/6 mx-auto text-center border border-blue-500 rounded-xl p-10 mt-12">
        <form method="POST">
            <h3 class="text-xl font-bold pb-4">
                Add Setter
            </h3>
            <label>
                <input type="text" class="hidden" name="csrf:csrf_token" value="{{ csrfToken }}">
            </label>
            <div>
                <label class="text-gray-600 font-bold inline-block pb-2"
                       for="setterName">
                    Setter Name

                </label>
                <input class="border border-gray-400 focus:outline-slate-400 rounded-md w-full shadow-sm px-5 py-2"
                       type="text"
                       name="str:setter_name"
                       id="setterName"
                       required
                       autofocus>
            </div>

            <div>
                <button type="submit" name="unset:addSetter"
                        class="bg-[#4F46E5] w-auto mt-3 p-2 rounded-md text-white font-bold cursor-pointer hover:bg-[#1811E5]">
                    Submit
                </button>
            </div>
        </form>
    </div>
    {% if setters %}
        <h3 class="h3-center">Existing Setters</h3>
        <ul class="list-disc ps-10 w-fit mx-auto">
            {% for setter in setters %}
                <li>{{ setter.getSetterName }}</li>
            {% endfor %}
        </ul>
    {% endif %}
{% endblock %}
